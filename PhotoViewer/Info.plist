<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleDisplayName</key>
    <string>Photo Viewer</string>
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>jpg</string>
                <string>jpeg</string>
                <string>jpe</string>
                <string>jfif</string>
                <string>png</string>
                <string>apng</string>
                <string>heic</string>
                <string>heif</string>
                <string>heics</string>
                <string>avif</string>
                <string>avifs</string>
                <string>tif</string>
                <string>tiff</string>
                <string>gif</string>
                <string>bmp</string>
                <string>dib</string>
                <string>webp</string>
                <string>jxl</string>
                <string>jp2</string>
                <string>j2k</string>
                <string>j2c</string>
                <string>jpf</string>
                <string>jpx</string>
                <string>psd</string>
                <string>exr</string>
                <string>tga</string>
                <string>targa</string>
                <string>hdr</string>
                <string>rgbe</string>
                <string>ico</string>
                <string>cur</string>
                <string>icns</string>
                <string>mpo</string>
                <string>pbm</string>
                <string>pgm</string>
                <string>ppm</string>
                <string>pnm</string>
                <string>sgi</string>
                <string>rgb</string>
                <string>rgba</string>
                <string>bw</string>
            </array>
            <key>CFBundleTypeIconFile</key>
            <string>AppIcon</string>
            <key>CFBundleTypeName</key>
            <string>Image</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>public.jpeg</string>
                <string>public.png</string>
                <string>public.heic</string>
                <string>public.heif</string>
                <string>public.heics</string>
                <string>public.avif</string>
                <string>public.avis</string>
                <string>public.tiff</string>
                <string>com.compuserve.gif</string>
                <string>com.microsoft.bmp</string>
                <string>org.webmproject.webp</string>
                <string>public.jpeg-2000</string>
                <string>public.jpeg-xl</string>
                <string>com.adobe.photoshop-image</string>
                <string>com.ilm.openexr-image</string>
                <string>com.truevision.tga-image</string>
                <string>public.radiance</string>
                <string>com.microsoft.ico</string>
                <string>com.microsoft.cur</string>
                <string>com.apple.icns</string>
                <string>public.mpo-image</string>
                <string>public.pbm</string>
                <string>com.sgi.sgi-image</string>
            </array>
        </dict>
    </array>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIconName</key>
    <string>AppIcon</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
	<string>1.4</string>
    <key>CFBundleVersion</key>
	<string>5</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.photography</string>
    <key>LSMinimumSystemVersion</key>
    <string>$(MACOSX_DEPLOYMENT_TARGET)</string>
    <key>LSMultipleInstancesProhibited</key>
    <true/>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSDesktopFolderUsageDescription</key>
    <string>Photo Viewer needs read-only access to your Desktop to find the previous and next images.</string>
    <key>NSDocumentsFolderUsageDescription</key>
    <string>Photo Viewer needs read-only access to your Documents folder to find the previous and next images.</string>
    <key>NSDownloadsFolderUsageDescription</key>
    <string>Photo Viewer needs read-only access to your Downloads folder to find the previous and next images.</string>
    <key>NSFileProviderDomainUsageDescription</key>
    <string>Photo Viewer needs read-only access to files managed by this provider to find the previous and next images.</string>
    <key>NSNetworkVolumesUsageDescription</key>
    <string>Photo Viewer needs read-only access to this network volume to find the previous and next images.</string>
    <key>NSRemovableVolumesUsageDescription</key>
    <string>Photo Viewer needs read-only access to this removable volume to find the previous and next images.</string>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
</dict>
</plist>
